# Supabase project (Settings -> API). Without these the app runs fully offline on the rules shipped in the app:
# no barcode cache, no rules updates, no reports or AI re-check.
EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public website (share pages /v/<code>, /corrections, /rules, /privacy). Links are hidden until set.
EXPO_PUBLIC_SHARE_BASE_URL=
