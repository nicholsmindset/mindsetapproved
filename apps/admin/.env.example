# Supabase project (Settings -> API). Without these the admin runs in offline mode:
# only the test bench works, against data/starter-rules.json.
# Live project (see docs/deployment.md). The anon key is public by design: RLS and grants protect the data.
# Use the legacy anon JWT, not the sb_publishable_ key: Edge Functions verify a JWT.
NEXT_PUBLIC_SUPABASE_URL=https://hombnfjwqhheyyvwemlk.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImhvbWJuZmp3cWhoZXl5dndlbWxrIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODcyNzI1ODUsImV4cCI6MjEwMjg0ODU4NX0.Nf3GC5fBY30yUUIbVYonY9nKS23eQFvk5Yh56Ea0uEM
# Optional: where the Publish button sends requests (defaults to <SUPABASE_URL>/functions/v1/publish-bundle)
PUBLISH_FUNCTION_URL=
# Public site URL (canonical links, sitemap)
NEXT_PUBLIC_SITE_URL=
# Server-only secret (32+ characters) for the corrections form; must equal the database copy.
# On the live project it already exists; read it in the Supabase SQL editor with:
#   select value from public.app_secrets where name = 'corrections';
# For a new project: insert into public.app_secrets (name, value) values ('corrections', '<secret>');
CORRECTIONS_SECRET=
